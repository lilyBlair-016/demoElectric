# Copy this file to .env and adjust it for your local installation.
# Never commit your .env or put real passwords in this example.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/demoElectric/'

# Customer Accounts CRUD and pagination.
database.default.hostname = localhost
database.default.database = electric_company
database.default.username = root
database.default.password = ""
database.default.DBDriver = MySQLi
database.default.port = 3306

# User registration and login.
database.auth.hostname = localhost
database.auth.database = electriccompany
database.auth.username = root
database.auth.password = ""
database.auth.DBDriver = MySQLi
database.auth.port = 3306

security.csrfProtection = session
